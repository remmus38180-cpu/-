{
  "manifest_version": 3,
  "name": "十大先進國藥價查詢導航器",
  "version": "1.0.0",
  "description": "一鍵查詢十大先進國官方藥品價格資料庫。輸入英文藥名，直達各國查詢頁面。",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://www.kegg.jp/*",
    "http://www.codage.ext.cnamts.fr/*",
    "https://formulary.drugplan.ehealthsask.ca/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "十大先進國藥價查詢"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
